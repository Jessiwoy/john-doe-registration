// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id              String   @id @default(uuid())
  fullName        String
  cpf             String   @unique
  email           String
  favoriteColorId String
  favoriteColor   Color    @relation(fields: [favoriteColorId], references: [id])
  observations    String?
  createdAt       DateTime @default(now())
}

model Color {
  id       String  @id @default(uuid())
  name     String
  value    String  @unique
  hex      String?
  isActive Boolean @default(true)

  clients Client[]
}
